# Supabase — optional. The whole app works with zero backend (Tier 1,
# anonymous, localStorage-only progress). Set these only once a real
# Supabase project exists, to enable Tier 2 (optional account + cross-device
# sync). Get them from Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never exposed to the browser. Used for
# content publishing (seeding/updating the seasons/modules/lessons/
# citations/quizzes/resources tables), never for anything user-facing.
SUPABASE_SERVICE_ROLE_KEY=
